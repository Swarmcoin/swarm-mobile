<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Background task identifiers are internal, never shown to anyone,
	     and are matched literally by ios/AppDelegate.swift. Left exactly
	     as upstream on purpose: renaming them changes behaviour and
	     brands nothing. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.transistorsoft.fetch</string>
		<string>Zingo_Refresh_Task_ID</string>
		<string>Zingo_Processing_Task_ID</string>
		<string>Zingo_Processing_Scheduler_Task_ID</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>$(BUNDLE_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<!-- A literal, not $(PRODUCT_NAME). PRODUCT_NAME is "Zingo" and stays
	     that way: it names the executable, the .app directory and
	     PRODUCT_MODULE_NAME, which Info.plist itself refers to below as
	     $(PRODUCT_MODULE_NAME).SceneDelegate — an internal identifier the
	     brief says not to rename. CFBundleName is not that; it is a
	     display string iOS falls back to in places like the Storage list,
	     so it says SWARM Wallet. (Apple's 15-character guidance: 12.) -->
	<key>CFBundleName</key>
	<string>SWARM Wallet</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- No CFBundleURLTypes and no LSApplicationQueriesSchemes.
	     Upstream claims the public `zcash:` URL scheme; SWARM is a
	     separate network and must not intercept Zcash payment links
	     on anyone's phone, so the claim is removed rather than renamed.
	     Nothing in the app depends on it: the `zcash:` handling in the
	     shared JavaScript parses strings that are pasted or scanned, not
	     links routed by iOS. -->
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Provenance, kept deliberately. SWARM Wallet is a fork and says so;
	     the MIT notices this app inherits stay in place. -->
	<key>NSHumanReadableCopyright</key>
	<string>SWARM Wallet. Based on Zingo Mobile by ZingoLabs (MIT licence), which builds on zingolib (MIT).</string>
	<key>NSCameraUsageDescription</key>
	<string>SWARM Wallet uses the camera only to scan a SWARM address or payment QR code. Nothing is photographed, stored or sent.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>SWARM Wallet uses Face ID or Touch ID to unlock your wallet on this device. Your wallet never leaves the phone.</string>
	<!-- Add-only, never read. Upstream declares NSPhotoLibraryUsageDescription,
	     which asks for READ access to the whole library; nothing in this app
	     reads photos. The narrower add key is the honest one.

	     Open question, recorded rather than hidden: a sweep of app/, screens/,
	     ui/ and ios/*.swift finds no photo-library API at all (no CameraRoll
	     dependency, no PHPhotoLibrary, no UIImageWriteToSavedPhotosAlbum) —
	     the receive QR is rendered on screen by react-native-qrcode-svg and
	     never saved. The CI job asserts whether the built binary references
	     any Photos symbol; if it does not, this key should be deleted too. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>SWARM Wallet only ever adds a receive-address QR code to your photos, and only when you ask it to. It never reads your library.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<!-- The three SWARM typefaces, bundled in the app so nothing is
	     fetched at runtime (a font request would leak that the wallet was
	     opened, and by whom, before it had done anything else).

	     react-native.config.js links assets/fonts for Android only
	     (`project: { android: {} }`), and this app does no runtime font
	     loading, so without these two pieces — the folder reference in
	     Zingo.xcodeproj and this list — every `fontFamily: 'Sora-…'` in
	     app/theme/typography.ts would silently fall back to the system
	     face and the design system would simply not appear on iOS.

	     The paths carry the `fonts/` prefix because the Xcode project
	     copies assets/fonts in as a folder reference, which keeps the
	     directory in the bundle and picks up any face added later
	     without another project edit. -->
	<key>UIAppFonts</key>
	<array>
		<string>fonts/Sora-Regular.ttf</string>
		<string>fonts/Sora-SemiBold.ttf</string>
		<string>fonts/Sora-Bold.ttf</string>
		<string>fonts/Manrope-Regular.ttf</string>
		<string>fonts/Manrope-Medium.ttf</string>
		<string>fonts/Manrope-SemiBold.ttf</string>
		<string>fonts/JetBrainsMono-Regular.ttf</string>
		<string>fonts/JetBrainsMono-Medium.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- `fetch` and `processing` only. Both exist for one declared purpose:
	     continuing wallet synchronisation while the app is not in front
	     (AppDelegate.swift registers the BGTaskScheduler identifiers above
	     and does nothing else with them).

	     Upstream also declares `remote-notification`. It is removed: the app
	     registers for no remote notifications anywhere (no
	     registerForRemoteNotifications in ios/*.swift, no push SDK in
	     package.json — @notifee/react-native schedules LOCAL reminders), so
	     the mode would be a background capability declared for a feature
	     that does not exist, which guideline 2.5.4 does not allow. The
	     matching `aps-environment` entitlement is removed with it; see
	     Zingo.entitlements. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- Upstream reads "LaunchScreen.storyboar": a typo, so iOS finds no
	     launch storyboard and shows a blank one. Corrected here so the
	     SWARM launch screen in LaunchScreen.storyboard is actually used. -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
